---
import type { Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;

const copy = {
  fr: {
    bannerTitle: "Installer l'application Cozy Space",
    bannerSubtitle: "Commandez plus vite et suivez vos colis directement depuis votre écran d'accueil.",
    installBtn: "Installer l'App",
    laterBtn: "Plus tard",
    modalTitle: "Épingler l'application sur votre écran",
    modalSubtitle: "Suivez ces 3 étapes simples pour ajouter le raccourci sur votre écran :",
    tabAndroid: "Android (Chrome)",
    tabIos: "iPhone / iPad (Safari)",
    androidStep1Title: "1. Ouvrez le menu",
    androidStep1Desc: "Appuyez sur les 3 petits points ⋮ en haut à droite de Google Chrome.",
    androidStep2Title: "2. Choisissez Installer",
    androidStep2Desc: "Appuyez sur « Installer l'application » ou « Ajouter à l'écran d'accueil ».",
    androidStep3Title: "3. Confirmez",
    androidStep3Desc: "Appuyez sur « Installer ». L'icône Cozy Space apparaît sur votre écran d'accueil !",
    androidDirectBtn: "Tenter l'installation directe",
    iosStep1Title: "1. Bouton Partager",
    iosStep1Desc: "En bas de votre écran dans Safari, appuyez sur le bouton Partager ⎋ (carré avec flèche vers le haut).",
    iosStep2Title: "2. Sur l'écran d'accueil",
    iosStep2Desc: "Faites défiler la liste vers le bas et appuyez sur « Sur l'écran d'accueil » ⊕.",
    iosStep3Title: "3. Valider",
    iosStep3Desc: "En haut à droite de votre écran, appuyez sur « Ajouter ».",
    gotItBtn: "C'est compris !"
  },
  ar: {
    bannerTitle: "تثبيت تطبيق Cozy Space DZ",
    bannerSubtitle: "اطلب بسرعة وتابع طلبياتك مباشرة من شاشة هاتفك الرئيسية.",
    installBtn: "تثبيت التطبيق",
    laterBtn: "لاحقاً",
    modalTitle: "طريقة تثبيت التطبيق على هاتفك",
    modalSubtitle: "اتبع 3 خطوات بسيطة حسب نوع هاتفك:",
    tabAndroid: "أندرويد (Chrome)",
    tabIos: "آيفون (Safari)",
    androidStep1Title: "1. افتح القائمة",
    androidStep1Desc: "اضغط على الثلاث نقاط الرأسية ⋮ أعلى يمين المتصفح في Google Chrome.",
    androidStep2Title: "2. اختر التثبيت",
    androidStep2Desc: "اضغط على «تثبيت التطبيق» أو «إضافة إلى الشاشة الرئيسية».",
    androidStep3Title: "3. تأكيد",
    androidStep3Desc: "اضغط على «تثبيت». ستظهر أيقونة Cozy Space DZ على شاشة هاتفك مباشرة!",
    androidDirectBtn: "محاولة التثبيت المباشر الآن",
    iosStep1Title: "1. زر المشاركة",
    iosStep1Desc: "أسفل شاشة متصفح Safari، اضغط على زر المشاركة ⎋ (المربع ذو السهم للأعلى).",
    iosStep2Title: "2. إضافة للشاشة الرئيسية",
    iosStep2Desc: "مرر الخيارات للأسفل واختر «إضافة إلى الشاشة الرئيسية» ⊕.",
    iosStep3Title: "3. تأكيد الإضافة",
    iosStep3Desc: "أعلى يمين الشاشة، اضغط على «إضافة» (Add). مبروك، تم التثبيت بنجاح!",
    gotItBtn: "فهمت، شكراً"
  }
}[locale];
---

<!-- 1. Bannière discrète (s'affiche une seule fois au début) -->
<div
  id="pwa-install-banner"
  class="fixed bottom-4 left-4 right-4 z-40 mx-auto hidden max-w-md transform transition-all duration-500 ease-out sm:bottom-6 sm:left-auto sm:right-6"
  dir={locale === 'ar' ? 'rtl' : 'ltr'}
>
  <div class="relative overflow-hidden rounded-2xl border border-brand-charcoal/20 bg-gradient-to-br from-[#1F2937] via-[#111827] to-[#0A0D14] p-4 text-white shadow-2xl backdrop-blur-xl">
    <div class="relative flex items-start gap-3.5">
      <!-- App Icon -->
      <div class="relative flex-shrink-0">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white p-1 shadow-md ring-1 ring-brand-gold/40">
          <img src="/images/brand/logo-cozy-space.jpg" alt="Cozy Space App Icon" class="h-full w-full object-contain rounded-lg" />
        </div>
      </div>

      <!-- Content -->
      <div class="flex-1 min-w-0 pr-6">
        <h4 class="text-sm font-bold text-white tracking-wide">{copy.bannerTitle}</h4>
        <p class="mt-1 text-xs leading-relaxed text-slate-300">{copy.bannerSubtitle}</p>

        <!-- Action buttons -->
        <div class="mt-3.5 flex items-center gap-2">
          <button
            type="button"
            id="pwa-install-button"
            class="inline-flex items-center justify-center rounded-full bg-brand-gold px-4 py-2 text-xs font-semibold text-brand-charcoal shadow-md transition hover:bg-white focus:outline-none"
          >
            <svg class="h-3.5 w-3.5 me-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            {copy.installBtn}
          </button>
          <button
            type="button"
            id="pwa-dismiss-button"
            class="rounded-full border border-white/20 bg-white/5 px-3.5 py-2 text-xs font-medium text-slate-300 transition hover:bg-white/10 hover:text-white"
          >
            {copy.laterBtn}
          </button>
        </div>
      </div>

      <!-- Close X button -->
      <button
        type="button"
        id="pwa-close-x"
        aria-label="Fermer"
        class="absolute top-0 right-0 p-1 text-slate-400 transition hover:text-white"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>
</div>

<!-- 2. Fenêtre Pop-up explicative complète pour iOS et Android -->
<div
  id="pwa-guide-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/80 p-4 backdrop-blur-md transition-opacity duration-300"
  dir={locale === 'ar' ? 'rtl' : 'ltr'}
>
  <div class="relative w-full max-w-lg overflow-hidden rounded-3xl border border-brand-gold/30 bg-gradient-to-br from-[#1F2937] via-[#111827] to-[#0A0D14] p-6 text-white shadow-2xl">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-white/10 pb-4">
      <div class="flex items-center gap-3">
        <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-white p-1 ring-1 ring-brand-gold/50 shadow-md">
          <img src="/images/brand/logo-cozy-space.jpg" alt="App Icon" class="h-full w-full object-contain rounded-lg" />
        </div>
        <div>
          <h3 class="text-base font-bold text-white sm:text-lg">{copy.modalTitle}</h3>
          <p class="text-xs text-brand-gold">{copy.modalSubtitle}</p>
        </div>
      </div>
      <button
        type="button"
        id="pwa-guide-close-btn"
        aria-label="Fermer"
        class="rounded-full bg-white/10 p-2 text-slate-300 transition hover:bg-white/20 hover:text-white"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Tabs Android vs iOS -->
    <div class="mt-5 grid grid-cols-2 gap-2 rounded-2xl bg-white/5 p-1.5 text-xs font-semibold">
      <button
        type="button"
        id="tab-android-btn"
        class="flex items-center justify-center gap-2 rounded-xl py-2.5 transition bg-brand-charcoal border border-brand-gold/40 text-white shadow-sm"
      >
        <svg class="h-4 w-4 text-green-400" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.551 0 .9993.4482.9993.9993.0001.5511-.4482.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993 0 .5511-.4482.9997-.9993.9997m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5802 8.4144 13.8466 8 12 8s-3.5802.4144-5.1368 1.0507L4.8409 5.5477a.416.416 0 00-.5676-.1521.416.416 0 00-.1521.5676l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3432-4.1021-2.6889-7.5743-6.1185-9.4396"/>
        </svg>
        <span>{copy.tabAndroid}</span>
      </button>

      <button
        type="button"
        id="tab-ios-btn"
        class="flex items-center justify-center gap-2 rounded-xl py-2.5 transition text-slate-300 hover:text-white"
      >
        <svg class="h-4 w-4 text-slate-200" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.84c.66-.82 1.11-1.96.99-3.1-.96.04-2.12.64-2.8 1.44-.6.69-1.13 1.83-.99 2.94 1.07.08 2.15-.54 2.8-1.28z"/>
        </svg>
        <span>{copy.tabIos}</span>
      </button>
    </div>

    <!-- Android Content -->
    <div id="content-android" class="mt-4 space-y-3">
      <div class="flex items-start gap-3 rounded-2xl border border-white/10 bg-white/[0.04] p-3.5">
        <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-xl bg-white/10 text-brand-gold font-bold text-sm">⋮</div>
        <div>
          <h4 class="text-xs font-bold text-white">{copy.androidStep1Title}</h4>
          <p class="mt-0.5 text-xs text-slate-300 leading-relaxed">{copy.androidStep1Desc}</p>
        </div>
      </div>

      <div class="flex items-start gap-3 rounded-2xl border border-white/10 bg-white/[0.04] p-3.5">
        <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-xl bg-white/10 text-brand-gold font-bold text-sm">⬇</div>
        <div>
          <h4 class="text-xs font-bold text-white">{copy.androidStep2Title}</h4>
          <p class="mt-0.5 text-xs text-slate-300 leading-relaxed">{copy.androidStep2Desc}</p>
        </div>
      </div>

      <div class="flex items-start gap-3 rounded-2xl border border-white/10 bg-white/[0.04] p-3.5">
        <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-xl bg-green-500/20 text-green-400 font-bold text-sm">✓</div>
        <div>
          <h4 class="text-xs font-bold text-white">{copy.androidStep3Title}</h4>
          <p class="mt-0.5 text-xs text-slate-300 leading-relaxed">{copy.androidStep3Desc}</p>
        </div>
      </div>

      <button
        type="button"
        id="pwa-direct-install-btn"
        class="mt-2 hidden w-full items-center justify-center rounded-xl bg-brand-gold py-2.5 text-xs font-semibold text-brand-charcoal shadow-md transition hover:bg-white"
      >
        {copy.androidDirectBtn}
      </button>
    </div>

    <!-- iOS Content -->
    <div id="content-ios" class="mt-4 hidden space-y-3">
      <div class="flex items-start gap-3 rounded-2xl border border-white/10 bg-white/[0.04] p-3.5">
        <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-xl bg-white/10 text-brand-gold font-bold text-base">⎋</div>
        <div>
          <h4 class="text-xs font-bold text-white">{copy.iosStep1Title}</h4>
          <p class="mt-0.5 text-xs text-slate-300 leading-relaxed">{copy.iosStep1Desc}</p>
        </div>
      </div>

      <div class="flex items-start gap-3 rounded-2xl border border-white/10 bg-white/[0.04] p-3.5">
        <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-xl bg-white/10 text-brand-gold font-bold text-base">⊕</div>
        <div>
          <h4 class="text-xs font-bold text-white">{copy.iosStep2Title}</h4>
          <p class="mt-0.5 text-xs text-slate-300 leading-relaxed">{copy.iosStep2Desc}</p>
        </div>
      </div>

      <div class="flex items-start gap-3 rounded-2xl border border-white/10 bg-white/[0.04] p-3.5">
        <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-xl bg-green-500/20 text-green-400 font-bold text-sm">✓</div>
        <div>
          <h4 class="text-xs font-bold text-white">{copy.iosStep3Title}</h4>
          <p class="mt-0.5 text-xs text-slate-300 leading-relaxed">{copy.iosStep3Desc}</p>
        </div>
      </div>
    </div>

    <!-- Footer button -->
    <div class="mt-6">
      <button
        type="button"
        id="pwa-guide-confirm-btn"
        class="w-full rounded-2xl bg-white/10 py-3 text-center text-xs font-semibold text-white transition hover:bg-white/20"
      >
        {copy.gotItBtn}
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const STORAGE_KEY = 'pwa_cozy_space_prompt_dismissed';
    let deferredPrompt = null;

    const banner = document.getElementById('pwa-install-banner');
    const bannerInstallBtn = document.getElementById('pwa-install-button');
    const bannerDismissBtn = document.getElementById('pwa-dismiss-button');
    const bannerCloseX = document.getElementById('pwa-close-x');

    const modal = document.getElementById('pwa-guide-modal');
    const modalCloseBtn = document.getElementById('pwa-guide-close-btn');
    const modalConfirmBtn = document.getElementById('pwa-guide-confirm-btn');

    const tabAndroidBtn = document.getElementById('tab-android-btn');
    const tabIosBtn = document.getElementById('tab-ios-btn');
    const contentAndroid = document.getElementById('content-android');
    const contentIos = document.getElementById('content-ios');
    const directInstallBtn = document.getElementById('pwa-direct-install-btn');

    // Register Service Worker
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }

    const selectTab = (tab) => {
      if (tab === 'android') {
        tabAndroidBtn?.classList.add('bg-brand-charcoal', 'border', 'border-brand-gold/40', 'text-white', 'shadow-sm');
        tabAndroidBtn?.classList.remove('text-slate-300');
        tabIosBtn?.classList.remove('bg-brand-charcoal', 'border', 'border-brand-gold/40', 'text-white', 'shadow-sm');
        tabIosBtn?.classList.add('text-slate-300');
        contentAndroid?.classList.remove('hidden');
        contentIos?.classList.add('hidden');
      } else {
        tabIosBtn?.classList.add('bg-brand-charcoal', 'border', 'border-brand-gold/40', 'text-white', 'shadow-sm');
        tabIosBtn?.classList.remove('text-slate-300');
        tabAndroidBtn?.classList.remove('bg-brand-charcoal', 'border', 'border-brand-gold/40', 'text-white', 'shadow-sm');
        tabAndroidBtn?.classList.add('text-slate-300');
        contentIos?.classList.remove('hidden');
        contentAndroid?.classList.add('hidden');
      }
    };

    tabAndroidBtn?.addEventListener('click', () => selectTab('android'));
    tabIosBtn?.addEventListener('click', () => selectTab('ios'));

    // Open guide modal (always available on click from footer or anywhere)
    const openGuideModal = () => {
      const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
      selectTab(isIOS ? 'ios' : 'android');

      if (deferredPrompt && directInstallBtn) {
        directInstallBtn.classList.remove('hidden');
        directInstallBtn.classList.add('flex');
      }

      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }
    };

    const closeGuideModal = () => {
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
      }
      dismissBanner();
    };

    modalCloseBtn?.addEventListener('click', closeGuideModal);
    modalConfirmBtn?.addEventListener('click', closeGuideModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeGuideModal();
    });

    // Make available globally & listen for all trigger elements
    window.openPwaInstallPrompt = openGuideModal;
    document.addEventListener('click', (e) => {
      const trigger = e.target && e.target.closest && e.target.closest('[data-open-pwa-guide], #footer-pwa-install-btn');
      if (trigger) {
        e.preventDefault();
        openGuideModal();
      }
    });

    const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
    if (isStandalone) {
      return;
    }

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      if (directInstallBtn) {
        directInstallBtn.classList.remove('hidden');
        directInstallBtn.classList.add('flex');
      }
    });

    directInstallBtn?.addEventListener('click', async () => {
      if (deferredPrompt) {
        deferredPrompt.prompt();
        const choice = await deferredPrompt.userChoice;
        if (choice && choice.outcome === 'accepted') {
          closeGuideModal();
        }
        deferredPrompt = null;
      }
    });

    const hasBeenDismissed = (() => {
      try {
        return localStorage.getItem(STORAGE_KEY) === 'true';
      } catch {
        return false;
      }
    })();

    if (!hasBeenDismissed) {
      setTimeout(() => {
        try {
          if (localStorage.getItem(STORAGE_KEY) === 'true') return;
        } catch {}
        if (banner) {
          banner.classList.remove('hidden');
          requestAnimationFrame(() => banner.classList.remove('opacity-0', 'translate-y-4'));
        }
      }, 3500);
    }

    bannerInstallBtn?.addEventListener('click', () => {
      if (deferredPrompt) {
        deferredPrompt.prompt();
      }
      openGuideModal();
    });

    bannerDismissBtn?.addEventListener('click', dismissBanner);
    bannerCloseX?.addEventListener('click', dismissBanner);

    window.addEventListener('appinstalled', () => {
      dismissBanner();
      closeGuideModal();
    });
  })();
</script>
